      "options": "Relay Channel"
    },
    {
      "fieldname": "relay_contact",
      "label": "Relay Contact",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "Relay Contact"
    },
    {
      "fieldname": "endpoint",
      "label": "Endpoint",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "requested_by",
      "label": "Requested By",
      "fieldtype": "Link",
      "read_only": 1,
      "options": "User"
    },
    {
      "fieldname": "started_at",
      "label": "Started At",
      "fieldtype": "Datetime",
      "read_only": 1
