{
  "doctype": "DocType",
  "name": "Relay Legacy Import",
  "module": "Relay Core",
  "autoname": "RELAY-IMPORT-.##########",
  "naming_rule": "Expression (old style)",
  "engine": "InnoDB",
  "field_order": [
    "source_bundle",
    "source_site",
    "source_conversation",
    "source_channel",
    "relay_contact",
    "channel",
    "business_doctype",
    "business_name",
    "user_mapping",
    "team_mapping",
    "delta_since",
    "status",
    "watermark",
    "last_creation",
    "last_source",
    "upper_creation",
    "upper_source",
    "imported",
    "skipped",
    "warnings",
    "reconcile_report",
    "source_metadata",
    "bundle_sha256"
  ],
  "fields": [
    {
      "fieldname": "source_conversation",
      "label": "Legacy conversation",
      "fieldtype": "Data",
      "reqd": 1,
      "description": "Original WhatsApp Core Conversation name on the source site"
    },
    {
      "fieldname": "relay_contact",
      "label": "Relay contact",
      "fieldtype": "Link",
      "options": "Relay Contact",
      "reqd": 1
    },
    {
      "fieldname": "channel",
      "label": "Relay channel",
      "fieldtype": "Link",
      "options": "Relay Channel",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nRunning\nCompleted",
      "default": "Draft",
      "read_only": 1,
      "description": "Completed means this pass was processed. Review all reconciliation mismatches before cutover."
    },
    {
      "fieldname": "last_source",
      "label": "Last imported source",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "upper_source",
      "label": "Source boundary",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "imported",
      "label": "Imported messages",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "skipped",
      "label": "Already present",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "warnings",
      "label": "Import notes",
      "fieldtype": "Long Text",
      "read_only": 1
    },
    {
      "fieldname": "source_bundle",
      "label": "Private source bundle",
      "fieldtype": "Link",
      "options": "File",
      "description": "Optional cross-site export bundle. Leave empty for a same-site import."
    },
    {
      "fieldname": "bundle_sha256",
      "label": "Pinned bundle checksum",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "source_site",
      "label": "Source site",
      "fieldtype": "Data",
      "description": "Stable source identity. Renaming the source requires retaining this value."
    },
    {
      "fieldname": "source_channel",
      "label": "Source channel",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "business_doctype",
      "label": "Explicit business DocType",
      "fieldtype": "Link",
      "options": "DocType"
    },
    {
      "fieldname": "business_name",
      "label": "Explicit business record",
      "fieldtype": "Data",
      "description": "Leave blank for restricted migration triage. No inferred business association."
    },
    {
      "fieldname": "user_mapping",
      "label": "Source user \u2192 target user",
      "fieldtype": "Code",
      "options": "JSON"
    },
    {
      "fieldname": "team_mapping",
      "label": "Source team \u2192 Relay team",
      "fieldtype": "Code",
      "options": "JSON"
    },
    {
      "fieldname": "delta_since",
      "label": "Delta from (inclusive)",
      "fieldtype": "Datetime",
      "description": "For a same-site delta, create a new import using the previous pass watermark. Includes modified rows."
    },
    {
      "fieldname": "watermark",
      "label": "Pass watermark",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "last_creation",
      "label": "Last source creation",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "upper_creation",
      "label": "Snapshot boundary creation",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "source_metadata",
      "label": "Original identities, links and collaboration history",
      "fieldtype": "Code",
      "options": "JSON",
      "read_only": 1
    },
    {
      "fieldname": "reconcile_report",
      "label": "Reconciliation report",
      "fieldtype": "Code",
      "options": "JSON",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ],
  "track_changes": 1
}
