{
  "doctype": "DocType",
  "name": "Relay Message Action",
  "module": "Relay Core",
  "autoname": "RELAY-MA-.##########",
  "naming_rule": "Expression (old style)",
  "engine": "InnoDB",
  "field_order": [
    "request_key",
    "source_message",
    "operation",
    "payload",
    "payload_hash",
    "status",
    "result",
    "outbound_message",
    "start_contact",
    "preview",
    "target_channel"
  ],
  "fields": [
    {
      "fieldname": "request_key",
      "label": "Request key",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "source_message",
      "label": "Source message",
      "fieldtype": "Link",
      "options": "Relay Message",
      "reqd": 0
    },
    {
      "fieldname": "operation",
      "label": "Operation",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "payload",
      "label": "Payload",
      "fieldtype": "JSON",
      "reqd": 1
    },
    {
      "fieldname": "payload_hash",
      "label": "Payload hash",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Dispatching\nQueued\nSubmitted\nUncertain\nRejected",
      "default": "Dispatching",
      "reqd": 1
    },
    {
      "fieldname": "result",
      "label": "Result",
      "fieldtype": "JSON"
    },
    {
      "fieldname": "outbound_message",
      "label": "Outbound message",
      "fieldtype": "Link",
      "options": "Relay Message"
    },
    {
      "fieldname": "start_contact",
      "label": "Starting conversation",
      "fieldtype": "Link",
      "options": "Relay Contact"
    },
    {
      "fieldname": "preview",
      "label": "Content preview",
      "fieldtype": "Small Text",
      "read_only": 1
    },
    {
      "fieldname": "target_channel",
      "label": "Channel",
      "fieldtype": "Link",
      "options": "Relay Channel",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1
    },
    {
      "role": "Relay Communication Manager",
      "read": 1
    },
    {
      "role": "WhatsApp Manager",
      "read": 1
    },
    {
      "role": "Relay Communication User",
      "read": 1,
      "if_owner": 1
    },
    {
      "role": "WhatsApp User",
      "read": 1,
      "if_owner": 1
    },
    {
      "role": "WhatsApp Multi-Channel User",
      "read": 1,
      "if_owner": 1
    }
  ]
}
