{
  "doctype": "DocType",
  "name": "Relay Genie Delivery",
  "module": "Relay Core",
  "engine": "InnoDB",
  "autoname": "field:message",
  "naming_rule": "By fieldname",
  "in_create": 1,
  "read_only": 1,
  "sort_field": "creation",
  "sort_order": "DESC",
  "title_field": "message",
  "field_order": [
    "message",
    "relay_contact",
    "status",
    "attempts",
    "next_try",
    "delivered_at",
    "last_error"
  ],
  "fields": [
    {
      "fieldname": "message",
      "label": "Message",
      "fieldtype": "Link",
      "options": "Relay Message",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "relay_contact",
      "label": "Chat",
      "fieldtype": "Link",
      "options": "Relay Contact",
      "reqd": 1,
      "in_standard_filter": 1,
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending\nSent\nReplied\nNoted\nNote Failed\nFailed\nSkipped",
      "default": "Pending",
      "in_list_view": 1,
      "in_standard_filter": 1,
      "read_only": 1,
      "description": "Pending: waiting for a try. Sent: Genie took it. 10 minutes later: Replied when the chat got a reply, Noted when it has a staff note (one is added when it has neither), Note Failed when that note failed. Failed: no try was accepted (a staff note is added). Skipped: not for Genie any more."
    },
    {
      "fieldname": "attempts",
      "label": "Attempts",
      "fieldtype": "Int",
      "default": "0",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "next_try",
      "label": "Next try",
      "fieldtype": "Datetime",
      "read_only": 1,
      "description": "Pending: when the scheduler sends it (again)."
    },
    {
      "fieldname": "delivered_at",
      "label": "Delivered at",
      "fieldtype": "Datetime",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "last_error",
      "label": "Last error",
      "fieldtype": "Data",
      "length": 140,
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Relay Communication Manager",
      "read": 1,
      "report": 1
    }
  ],
  "modified": "2026-11-25 13:00:00.000000"
}
