{
  "doctype": "DocType",
  "name": "Relay Business Event Rule",
  "module": "Relay Core",
  "engine": "InnoDB",
  "autoname": "format:{title}-{###}",
  "naming_rule": "Expression",
  "track_changes": 1,
  "field_order": [
    "title",
    "enabled",
    "source_doctype",
    "event",
    "recipient_field",
    "business_doctype",
    "channel",
    "run_as_user",
    "template",
    "parameter_mapping",
    "sample_key",
    "contact",
    "use_preferences",
    "telegram_body",
    "email_subject",
    "email_body",
    "email_signature",
    "condition",
    "recipients_section",
    "recipients",
    "contact_field",
    "attachment_type",
    "print_format",
    "report_name",
    "report_filters",
    "file_name"
  ],
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check"
    },
    {
      "fieldname": "source_doctype",
      "label": "Source Doctype",
      "fieldtype": "Link",
      "options": "DocType",
      "reqd": 1
    },
    {
      "fieldname": "event",
      "label": "Event",
      "fieldtype": "Select",
      "options": "on_submit\nafter_insert\non_cancel",
      "reqd": 1
    },
    {
      "fieldname": "recipient_field",
      "label": "Recipient Field",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "business_doctype",
      "label": "Business Doctype",
      "fieldtype": "Link",
      "options": "DocType",
      "reqd": 1
    },
    {
      "fieldname": "channel",
      "label": "Channel",
      "fieldtype": "Link",
      "options": "Relay Channel"
    },
    {
      "fieldname": "run_as_user",
      "label": "Run As User",
      "fieldtype": "Link",
      "options": "User"
    },
    {
      "fieldname": "template",
      "label": "Template",
      "fieldtype": "Link",
      "options": "Relay WhatsApp Template"
    },
    {
      "fieldname": "parameter_mapping",
      "label": "Parameter Mapping",
      "fieldtype": "JSON",
      "default": "[]"
    },
    {
      "fieldname": "sample_key",
      "label": "Sample Key",
      "fieldtype": "Data",
      "unique": 1
    },
    {
      "fieldname": "contact",
      "label": "Recipient Person",
      "fieldtype": "Link",
      "options": "Contact"
    },
    {
      "fieldname": "use_preferences",
      "label": "Use Channel Preferences",
      "fieldtype": "Check"
    },
    {
      "fieldname": "telegram_body",
      "label": "Telegram Text",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "email_subject",
      "label": "Email Subject",
      "fieldtype": "Data"
    },
    {
      "fieldname": "email_body",
      "label": "Email Text",
      "fieldtype": "Long Text"
    },
    {
      "fieldname": "email_signature",
      "label": "Email Signature",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "condition",
      "label": "Condition",
      "fieldtype": "Small Text",
      "description": "Optional Python expression on doc, such as doc.commitment_level_label. The rule runs only when it is true."
    },
    {
      "fieldname": "recipients_section",
      "label": "Recipients and PDF",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "recipients",
      "label": "Recipients",
      "fieldtype": "Select",
      "options": "\nPrimary contact\nAll business contacts\nDocument contact field",
      "description": "Empty: the business must have exactly one contact."
    },
    {
      "fieldname": "contact_field",
      "label": "Contact Field",
      "fieldtype": "Data",
      "depends_on": "eval:doc.recipients=='Document contact field'"
    },
    {
      "fieldname": "attachment_type",
      "label": "Attach PDF",
      "fieldtype": "Select",
      "options": "\nPrint Format\nReport"
    },
    {
      "fieldname": "print_format",
      "label": "Print Format",
      "fieldtype": "Link",
      "options": "Print Format",
      "depends_on": "eval:doc.attachment_type=='Print Format'"
    },
    {
      "fieldname": "report_name",
      "label": "Report",
      "fieldtype": "Link",
      "options": "Report",
      "depends_on": "eval:doc.attachment_type=='Report'"
    },
    {
      "fieldname": "report_filters",
      "label": "Report Filters",
      "fieldtype": "JSON",
      "depends_on": "eval:doc.attachment_type=='Report'",
      "description": "JSON object. Use {{doc.field}} for values of the document."
    },
    {
      "fieldname": "file_name",
      "label": "File Name",
      "fieldtype": "Data",
      "depends_on": "attachment_type",
      "description": "For example Order_{{doc.name}}.pdf"
    }
  ],
  "permissions": [
    {
      "role": "Relay Communication Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ],
  "title_field": "title",
  "modified": "2026-10-27 12:00:00.000000"
}
