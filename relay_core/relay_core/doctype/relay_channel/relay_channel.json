{
  "doctype": "DocType",
  "name": "Relay Channel",
  "module": "Relay Core",
  "autoname": "format:{title}-{###}",
  "naming_rule": "Expression",
  "engine": "InnoDB",
  "field_order": [
    "title",
    "channel",
    "account",
    "hub_channel",
    "label",
    "address",
    "waba_id",
    "is_default",
    "enabled",
    "company",
    "triage_owner",
    "configuration",
    "mailbox_address",
    "mailbox_aliases"
  ],
  "fields": [
    {
      "fieldname": "title",
      "label": "Title",
      "fieldtype": "Data",
      "in_list_view": 1
    },
    {
      "fieldname": "channel",
      "label": "Channel",
      "fieldtype": "Select",
      "options": "WhatsApp\nTelegram\nEmail",
      "reqd": 1
    },
    {
      "fieldname": "account",
      "label": "Account",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "hub_channel",
      "label": "Hub channel",
      "fieldtype": "Data",
      "read_only": 1,
      "description": "Hub channel key of this number, bot or mailbox. Inbound events and sends use it."
    },
    {
      "fieldname": "label",
      "label": "Label",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "address",
      "label": "Address",
      "fieldtype": "Data",
      "read_only": 1,
      "description": "Display number, bot username or mailbox address from the Hub."
    },
    {
      "fieldname": "waba_id",
      "label": "WhatsApp Business Account",
      "fieldtype": "Data",
      "read_only": 1,
      "depends_on": "eval:doc.channel=='WhatsApp'"
    },
    {
      "fieldname": "is_default",
      "label": "Default for new conversations",
      "fieldtype": "Check",
      "description": "One default per channel type."
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check"
    },
    {
      "fieldname": "configuration",
      "label": "Configuration",
      "fieldtype": "Section Break",
      "permlevel": 1
    },
    {
      "fieldname": "mailbox_address",
      "label": "Mailbox address",
      "fieldtype": "Data",
      "permlevel": 1,
      "depends_on": "eval:doc.channel=='Email'",
      "description": "Trusted configured mailbox identity. Aliases may be comma or newline separated."
    },
    {
      "fieldname": "mailbox_aliases",
      "label": "Mailbox aliases",
      "fieldtype": "Small Text",
      "permlevel": 1,
      "depends_on": "eval:doc.channel=='Email'",
      "description": "Trusted configured mailbox identity. Aliases may be comma or newline separated."
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "description": "Exactly one company is required before activating AI events."
    },
    {
      "fieldname": "triage_owner",
      "label": "Triage owner",
      "fieldtype": "Link",
      "options": "User",
      "description": "Enabled Relay staff responsible for unmatched or unresolved messages."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Relay Communication Manager",
      "read": 1,
      "report": 1
    },
    {
      "role": "WhatsApp Manager",
      "read": 1,
      "report": 1
    },
    {
      "role": "Relay Communication User",
      "read": 1
    },
    {
      "role": "WhatsApp User",
      "read": 1
    },
    {
      "role": "WhatsApp Multi-Channel User",
      "read": 1
    },
    {
      "role": "System Manager",
      "permlevel": 1,
      "read": 1,
      "write": 1
    }
  ],
  "sort_field": "creation",
  "sort_order": "DESC",
  "track_changes": 1,
  "title_field": "title",
  "modified": "2026-10-27 12:00:00.000000"
}
